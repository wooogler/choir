# ─────────────────────────────────────────────────────────────────────────────
# CHOIR environment template.
# Copy this file to `.env` (production) or `.env.development` (local) and fill
# in the values. The defaults below match a self-hosted, single-workspace
# deployment. See README.md for the OAuth distribution mode.
# ─────────────────────────────────────────────────────────────────────────────

# ── Slack runtime mode ───────────────────────────────────────────────────────
# single = self-hosted, one workspace, uses SLACK_BOT_TOKEN.
# oauth  = multi-workspace install flow, uses SLACK_CLIENT_ID/SECRET.
SLACK_MODE=single
NODE_ENV=production
PORT=3000

# ── Slack app credentials ────────────────────────────────────────────────────
# Required in every mode.
SLACK_SIGNING_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: shown as a deep-link target in App Home.
SLACK_APP_ID=Axxxxxxxxxx

# Single mode (SLACK_MODE=single):
SLACK_BOT_TOKEN=xoxb-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Only needed when running Socket Mode locally (NODE_ENV=development).
SLACK_APP_TOKEN=xapp-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OAuth mode (SLACK_MODE=oauth) — leave commented out for single mode.
# SLACK_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxx
# SLACK_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxx
# SLACK_STATE_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# SLACK_REDIRECT_URI=https://your-domain.example/slack/oauth_redirect
# SLACK_SCOPES=app_mentions:read,channels:history,channels:read,chat:write,groups:history,im:history,im:read,im:write,mpim:history,mpim:read,mpim:write,team:read,users:read,files:write

# ── SQLite storage ───────────────────────────────────────────────────────────
DATABASE_URL=file:data/choir.db
# Optional 32-byte hex key used to encrypt Slack installations and workspace
# config JSON. Generate with: openssl rand -hex 32
# If omitted, CHOIR creates data/.choir-db-key on first encrypted write.
# CHOIR_DB_ENCRYPTION_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your_openai_api_key
OPENAI_MODEL=gpt-4o
OPENAI_MODEL_NAME=gpt-4o-mini
OPENAI_EMBEDDINGS_MODEL=text-embedding-3-large
OPENAI_RESPONSES_MODEL=gpt-4o-mini
OPENAI_QUERY_EXPANSION_MODEL=gpt-4o-mini
OPENAI_QUERY_EXPANSION_MAX_LEX_QUERIES=2
OPENAI_QUERY_EXPANSION_CACHE_TTL_MS=300000

# ── GitHub integration ───────────────────────────────────────────────────────
# Managers connect their own GitHub account via OAuth device flow.
# Create a GitHub OAuth App with "Device Flow" enabled, then paste the
# client ID and client secret here.
GITHUB_OAUTH_CLIENT_ID=your_client_id_here
GITHUB_OAUTH_CLIENT_SECRET=your_client_secret_here

# Optional: enables auto-reindex on push events (HTTP mode only).
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# ── Retrieval (QMD) ──────────────────────────────────────────────────────────
RETRIEVAL_MIRROR_FIRST=true
QMD_SEARCH_MODE=hybrid
QMD_UPDATE_SNIPPET_MAX_LEN=500
QMD_WARMUP_ON_STARTUP=true
QMD_WARMUP_QUERY=documentation
QMD_FORCE_CPU_ONLY=true
NODE_LLAMA_CPP_GPU=off

# ── CHOIR options ────────────────────────────────────────────────────────────
# Shared password managers enter in App Home to gain manager-only controls.
MANAGER_PROMOTION_PASSWORD=choir
# Link shown during onboarding flows.
CHOIR_CONSENT_FORM_URL=https://forms.gle/UQxcPuTbVKroheNp9
# Usage monitor: log a warning when a single user exceeds this many CHOIR
# interactions in the rolling window, filtered by these username keywords.
CHOIR_USAGE_ALERT_THRESHOLD=30
CHOIR_USAGE_ALERT_KEYWORDS=(CHOIR)
# Set DEBUG=true to enable verbose logging in production (NODE_ENV=development
# already enables debug logs).
DEBUG=false

# ── Docs viewer ──────────────────────────────────────────────────────────────
# Public base URL used when the QMD provider rewrites doc references.
DOCS_BASE_URL=https://your-domain.example
