# syntax=docker/dockerfile:1

# ── Web frontend build ────────────────────────────────────────────────────────
FROM node:22-bookworm-slim AS web-builder

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@10.8.1 --activate

COPY .npmrc package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY web ./web

# The viewer shares three vocabularies with the server rather than keeping its
# own copy that could drift: the supported locales, the docs API's error codes,
# and the import steps. They are deliberately import-free so they can be pulled
# across the workspace boundary, but `tsc` still needs the files to exist at the
# paths `web/src` reaches for. Copied one by one, not as whole directories, so a
# backend change does not invalidate this layer's cache — and so a new
# cross-boundary import fails the build here instead of silently shipping.
# __tests__/web-shared-modules.test.ts keeps this list honest.
COPY src/i18n/supported-locales.ts ./src/i18n/supported-locales.ts
COPY services/docs-editor/api-errors.ts ./services/docs-editor/api-errors.ts
COPY services/google/import-steps.ts ./services/google/import-steps.ts

RUN --mount=type=cache,target=/pnpm/store,id=pnpm-store-web,sharing=locked \
    pnpm --filter choir-web install --frozen-lockfile --store-dir=/pnpm/store
RUN pnpm --filter choir-web build
# output lands at /app/public/docs-app/ (vite outDir: '../public/docs-app')

# ── Backend dependencies ──────────────────────────────────────────────────────
FROM node:22-bookworm-slim AS deps

ENV PUPPETEER_SKIP_DOWNLOAD=true
ENV QMD_FORCE_CPU_ONLY=true
ENV NODE_ENV=production

WORKDIR /app

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      ca-certificates \
      cmake \
      g++ \
      make \
      pkg-config \
      python3 && \
    rm -rf /var/lib/apt/lists/*

RUN corepack enable && corepack prepare pnpm@10.8.1 --activate

COPY .npmrc package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN --mount=type=cache,target=/pnpm/store,id=pnpm-store-prod,sharing=locked \
    pnpm install --prod --frozen-lockfile --store-dir=/pnpm/store && \
    rm -rf \
      node_modules/.pnpm/@node-llama-cpp+linux-arm64@* \
      node_modules/.pnpm/@node-llama-cpp+linux-armv7l@* \
      node_modules/.pnpm/@node-llama-cpp+linux-x64-cuda@* \
      node_modules/.pnpm/@node-llama-cpp+linux-x64-cuda-ext@* \
      node_modules/.pnpm/@node-llama-cpp+linux-x64-vulkan@* \
      node_modules/@node-llama-cpp/linux-arm64 \
      node_modules/@node-llama-cpp/linux-armv7l \
      node_modules/@node-llama-cpp/linux-x64-cuda \
      node_modules/@node-llama-cpp/linux-x64-cuda-ext \
      node_modules/@node-llama-cpp/linux-x64-vulkan

FROM node:22-bookworm-slim AS runner

ENV NODE_ENV=production
ENV PORT=3000
ENV QMD_FORCE_CPU_ONLY=true
ENV PUPPETEER_SKIP_DOWNLOAD=true

WORKDIR /app

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      ca-certificates \
      curl \
      libgomp1 && \
    rm -rf /var/lib/apt/lists/*

COPY --from=deps --chown=node:node /app/node_modules ./node_modules
COPY --chown=node:node dist ./dist
COPY --chown=node:node public ./public
COPY --from=web-builder --chown=node:node /app/public/docs-app ./public/docs-app
COPY --chown=node:node package.json ./package.json

RUN mkdir -p /app/data && chown -R node:node /app/data

USER node

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD curl -fsS http://127.0.0.1:3000/healthz || exit 1

CMD ["node", "dist/app.js"]
