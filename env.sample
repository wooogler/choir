# Slack
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token
SLACK_SIGNING_SECRET=your-signing-secret

# Optional but recommended for App Home deep links and OAuth flows
SLACK_APP_ID=A0123456789
SLACK_CLIENT_ID=1234567890.1234567890
SLACK_CLIENT_SECRET=your-slack-client-secret

# Runtime
NODE_ENV=development
PORT=3000
DEBUG=false
ENABLE_WEB_CONTENT=false
RETRIEVAL_PROVIDER=faiss
RETRIEVAL_MIRROR_FIRST=true
UPDATE_RETRIEVAL_PROVIDER=qmd
QMD_SEARCH_MODE=hybrid
QMD_UPDATE_SNIPPET_MAX_LEN=500
QMD_WARMUP_ON_STARTUP=true
QMD_WARMUP_QUERY=documentation
QMD_FORCE_CPU_ONLY=true
NODE_LLAMA_CPP_GPU=off

# OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDINGS_MODEL=text-embedding-3-small
OPENAI_MODEL_NAME=gpt-4o-mini
OPENAI_RESPONSES_MODEL=gpt-4o-mini
OPENAI_QUERY_EXPANSION_MODEL=gpt-4o-mini
OPENAI_QUERY_EXPANSION_MAX_LEX_QUERIES=2
OPENAI_QUERY_EXPANSION_CACHE_TTL_MS=300000

# GitHub
GITHUB_TOKEN=your-github-token
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret
GITHUB_OAUTH_CLIENT_ID=your-github-oauth-client-id
GITHUB_OAUTH_CLIENT_SECRET=your-github-oauth-client-secret

# CHOIR options
MANAGER_PROMOTION_PASSWORD=optional-manager-password
CHOIR_CONSENT_FORM_URL=https://example.com/consent
CHOIR_USAGE_ALERT_THRESHOLD=30
CHOIR_USAGE_ALERT_KEYWORDS=(CHOIR)
