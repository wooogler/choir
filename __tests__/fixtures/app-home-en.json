    {
      "type": "actions",
      "elements": [
        {
          "type": "button",
          "text": {
            "type": "plain_text",
            "text": "💬 Start Chatting with CHOIR",
            "emoji": true
          },
          "action_id": "start_chat_url",
          "url": "slack://app?team=T1&id=A123&tab=messages",
          "style": "primary"
        },
        {
          "type": "button",
          "text": {
            "type": "plain_text",
            "text": "📖 Open Docs",
            "emoji": true
          },
          "action_id": "open_docs_url",
          "url": "https://docs.example.com/docs/T1"
        }
      ]
    },
    {
      "type": "divider"
    },
    {
      "type": "section",
      "text": {
        "type": "mrkdwn",
        "text": "*Your language*\nThe language CHOIR uses when it talks to you."
      },
      "accessory": {
        "type": "static_select",
        "action_id": "set_my_language",
        "placeholder": {
          "type": "plain_text",
          "text": "Select a language",
          "emoji": true
        },
        "options": [
          {
            "text": {
              "type": "plain_text",
              "text": "Automatic (follows your Slack language)",
              "emoji": true
            },
            "value": "auto"
          },
          {
            "text": {
              "type": "plain_text",
              "text": "English",
              "emoji": true
            },
            "value": "en"
          },
          {
            "text": {
              "type": "plain_text",
              "text": "한국어",
              "emoji": true
            },
            "value": "ko"
          }
        ],
        "initial_option": {
          "text": {
            "type": "plain_text",
            "text": "Automatic (follows your Slack language)",
            "emoji": true
          },
          "value": "auto"
        }
      }
    },
    {
      "type": "divider"
    },
    {
      "type": "section",
      "text": {
        "type": "mrkdwn",
        "text": "*Setup*\n✅ GitHub account · octocat\n✅ Repository · acme/docs (Path: docs)\n✅ Q&A channel · #qa-channel\n✅ 3 CHOIR users · 2 managers"
      }
    }
  ],
