    {
      "type": "section",
      "text": {
        "type": "mrkdwn",
        "text": "*Read-only files*\n1 of 2 files are excluded from updates"
      },
      "accessory": {
        "type": "button",
        "text": {
          "type": "plain_text",
          "text": "Manage Read-Only Files",
          "emoji": true
        },
        "action_id": "manage_readonly_files"
      }
    },
    {
      "type": "context",
      "elements": [
        {
          "type": "mrkdwn",
          "text": "Currently excluded: docs/a.md"
        }
      ]
    },
    {
      "type": "section",
      "text": {
        "type": "mrkdwn",
        "text": "*Document content language*\nLanguage CHOIR writes new document content in; 'Follow the conversation' keeps today's behaviour"
      },
      "accessory": {
        "type": "static_select",
        "action_id": "set_content_language",
        "placeholder": {
          "type": "plain_text",
          "text": "Select a language",
          "emoji": true
        },
        "options": [
          {
            "text": {
              "type": "plain_text",
              "text": "Follow the conversation",
              "emoji": true
            },
            "value": "follow-conversation"
          },
          {
            "text": {
              "type": "plain_text",
              "text": "English",
              "emoji": true
            },
            "value": "en"
          },
          {
            "text": {
              "type": "plain_text",
              "text": "한국어",
              "emoji": true
            },
            "value": "ko"
          }
        ],
        "initial_option": {
          "text": {
            "type": "plain_text",
            "text": "Follow the conversation",
            "emoji": true
          },
          "value": "follow-conversation"
        }
      }
    },
    {
      "type": "divider"
    },
    {
      "type": "section",
      "text": {
        "type": "mrkdwn",
        "text": "*Index maintenance*\nRun after editing markdown files or when answers look stale."
      }
    },
    {
      "type": "actions",
      "elements": [
        {
          "type": "button",
          "text": {
            "type": "plain_text",
            "text": "Reload from GitHub",
            "emoji": true
          },
          "action_id": "reload_from_github",
          "confirm": {
            "title": {
              "type": "plain_text",
              "text": "Reload from GitHub?"
            },
            "text": {
              "type": "plain_text",
              "text": "This will fetch the latest files from GitHub and update the vector store. Any unsaved changes will be overwritten."
            },
            "confirm": {
              "type": "plain_text",
              "text": "Reload"
            },
            "deny": {
              "type": "plain_text",
              "text": "Cancel"
            }
          }
        },
        {
          "type": "button",
          "text": {
            "type": "plain_text",
            "text": "Normalize Markdown",
            "emoji": true
          },
          "action_id": "normalize_markdown_files",
          "confirm": {
            "title": {
              "type": "plain_text",
              "text": "Normalize Markdown Files"
            },
            "text": {
              "type": "plain_text",
              "text": "This will convert all markdown files to tree format and back to markdown, standardizing the formatting. This may change newlines, list styles, etc."
            },
            "confirm": {
              "type": "plain_text",
              "text": "Normalize"
            },
            "deny": {
              "type": "plain_text",
              "text": "Cancel"
            }
          }
        },
        {
          "type": "button",
          "text": {
            "type": "plain_text",
            "text": "Rebuild QMD Index",
            "emoji": true
          },
          "action_id": "rebuild_qmd_index",
          "confirm": {
            "title": {
              "type": "plain_text",
              "text": "Rebuild QMD Index?"
            },
            "text": {
              "type": "plain_text",
              "text": "This will delete the local QMD SQLite index and rebuild it from the synced markdown mirror. Use this after chunking changes or if retrieval looks stale."
            },
            "confirm": {
              "type": "plain_text",
              "text": "Rebuild"
            },
            "deny": {
              "type": "plain_text",
              "text": "Cancel"
            }
          }
        }
      ]
    }
  ],
