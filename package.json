{
  "name": "choir",
  "version": "1.0.0",
  "description": "AI-powered Slack bot for answering questions and updating organizational documentation from GitHub markdown files.",
  "main": "dist/app.js",
  "scripts": {
    "build": "rm -rf dist && tsc && tsc-alias",
    "start": "node dist/app.js",
    "dev": "NODE_ENV=development ts-node -r tsconfig-paths/register app.ts",
    "dev:watch": "nodemon --watch '**/*.ts' --exec 'ts-node -r tsconfig-paths/register' app.ts",
    "dev:prod": "NODE_ENV=production ts-node -r tsconfig-paths/register app.ts",
    "dev:web": "NODE_ENV=development ENABLE_WEB_CONTENT=true ts-node -r tsconfig-paths/register app.ts",
    "migrate:sqlite": "ts-node -r tsconfig-paths/register scripts/migrate-to-sqlite.ts",
    "purge:workspace-cache": "ts-node -r tsconfig-paths/register scripts/purge-workspace-cache.ts",
    "lint": "node scripts/run-biome-changed.js check",
    "lint:fix": "node scripts/run-biome-changed.js write",
    "lint:all": "npx @biomejs/biome check *.ts listeners services scripts __tests__ src",
    "lint:all:fix": "npx @biomejs/biome check --write *.ts listeners services scripts __tests__ src",
    "test:unit": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test": "pnpm test:unit",
    "verify": "pnpm build && pnpm test:unit"
  },
  "author": "CHOIR contributors",
  "license": "MIT",
  "keywords": [
    "slack",
    "bolt",
    "typescript",
    "github",
    "openai",
    "knowledge-base",
    "rag"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/wooogler/choir.git"
  },
  "bugs": {
    "url": "https://github.com/wooogler/choir/issues"
  },
  "dependencies": {
    "@langchain/community": "^0.3.48",
    "@langchain/core": "^0.3.62",
    "@langchain/openai": "^0.5.18",
    "@slack/bolt": "^4.2.0",
    "@slack/web-api": "^7.8.0",
    "@tobilu/qmd": "^2.0.1",
    "@types/archiver": "^6.0.3",
    "@types/diff": "^7.0.0",
    "@types/mdast": "^4.0.4",
    "@types/unist": "^3.0.3",
    "archiver": "^7.0.1",
    "better-sqlite3": "^12.9.0",
    "diff": "^7.0.0",
    "dotenv": "~16.4.7",
    "faiss-node": "^0.5.1",
    "langchain": "^0.3.29",
    "marked": "^15.0.6",
    "mdast-util-to-string": "^4.0.0",
    "octokit": "^4.1.0",
    "openai": "^4.80.0",
    "puppeteer": "^24.9.0",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-is": "^6.0.0",
    "unist-util-visit": "^5.0.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^30.0.0",
    "@types/uuid": "^10.0.0",
    "jest": "^30.0.3",
    "nodemon": "^3.1.9",
    "ts-jest": "^29.4.0",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  }
}
